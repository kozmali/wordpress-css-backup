#. Plugin Name
msgid "Additional CSS Backup (Zálohovanie Dodatočných CSS)"
msgstr "Additional CSS Backup"

#. Description
msgid "Automatické a manuálne zálohy pre Dodatočné CSS s podporou obnovy aj stiahnutia."
msgstr "Automatic and manual backups for WordPress Additional CSS with restore and download support."

#. Menu titles
msgid "Zálohy Dodatočného CSS"
msgstr "Additional CSS Backups"

msgid "Zálohy CSS"
msgstr "CSS Backups"

#. Backup labels
msgid "automatická týždenná záloha"
msgstr "automatic weekly backup"

msgid "automaticky pred obnovou"
msgstr "automatic before restore"

#. Admin notices
msgid "Bezpečnostná chyba."
msgstr "Security error."

msgid "Záloha bola vytvorená!"
msgstr "Backup created successfully!"

msgid "⚠️ Žiadne zmeny, záloha nebola vytvorená."
msgstr "⚠️ No changes detected, backup was not created."

msgid "✅ CSS bolo obnovené zo zálohy!"
msgstr "✅ CSS restored from backup!"

msgid "🗑️ Záloha bola odstránená."
msgstr "🗑️ Backup has been removed."

#. Dashboard / Page content
msgid "Aktuálne Dodatočné CSS"
msgstr "Current Additional CSS"

msgid "Zatiaľ žiadne Dodatočné CSS."
msgstr "No Additional CSS found yet."

msgid "Vytvoriť zálohu teraz"
msgstr "Create backup now"

msgid "Posledné zálohy (max. 20)"
msgstr "Recent backups (max. 20)"

msgid "celkom"
msgstr "total"

msgid "Dátum"
msgstr "Date"

msgid "Náhľad CSS"
msgstr "CSS Preview"

msgid "Akcie"
msgstr "Actions"

msgid "Zatiaľ žiadne zálohy."
msgstr "No backups yet."

#. Buttons & Tooltips
msgid "Obnoviť"
msgstr "Restore"

msgid "Stiahnuť"
msgstr "Download"

msgid "Zmazať"
msgstr "Delete"

msgid "Zálohovať CSS"
msgstr "Backup CSS"

#. Confirmations
msgid "Naozaj obnoviť túto zálohu?"
msgstr "Are you sure you want to restore this backup?"

msgid "Odstrániť túto zálohu?"
msgstr "Delete this backup?"